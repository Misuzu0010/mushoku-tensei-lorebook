# ==========================================
# Python Virtual Environments
# ==========================================
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# Python Bytecode and Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Testing & Linting
# ==========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# Raw Ebook Binaries & Source Inputs
# ==========================================
# 忽略原始EPUB二进制图书与输入源文件，保护版权及控制仓库体积
inputs/
*.epub

# ==========================================
# Raw Novel Texts & Intermediate Outputs (严格规避版权)
# ==========================================
# 忽略 outputs/ 整个目录（包括小说原文章节 outputs/chapters/ 与原文提取草稿 outputs/world_raw/）
# 仅保留清洗提炼后的纯世界书 world_stages/
outputs/

# ==========================================
# Scratch / Temporary Working Files
# ==========================================
# 忽略临时调试脚本、临时日志与试验数据文件
scratch/
*.tmp
*.log

# ==========================================
# OS & Editor Generated Files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
