# ==========================================
# Python Virtual Environments
# ==========================================
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# Python Bytecode and Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Testing & Linting
# ==========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# Raw Ebook Binaries & Source Inputs
# ==========================================
# 忽略原始EPUB二进制图书与输入源文件，保护版权及控制仓库体积
inputs/
*.epub

# ==========================================
# Novel Raw Text (小说原文章节，严禁上传)
# ==========================================
# 严格禁止将小说原文正文（outputs/chapters/）上传至仓库
outputs/chapters/

# ==========================================
# Scratch / Temporary Working Files
# ==========================================
# 忽略临时调试脚本、临时日志与试验数据文件
scratch/
*.tmp
*.log

# ==========================================
# OS & Editor Generated Files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
